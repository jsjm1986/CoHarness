{
  "name": "@deepseek-ai/dsh-session-format-v5-to-v6",
  "description": "Adjacent V5-to-V6 migration preserving SSH target metadata and event identities",
  "version": "0.1.5-alpha.1.coharness.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-format-v5-to-v6"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "sessionFormatMigration": {
      "from": 5,
      "to": 6,
      "export": ".",
      "migration": "sessionFormatV5ToV6",
      "sourceCodec": "releasedV5SessionFormatCodec",
      "targetCodec": "releasedV6SessionFormatCodec",
      "targetHeaderValidator": "assertReleasedV6Header",
      "targetRestorer": "restoreReleasedV6Artifact"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-session-format": "workspace:^",
    "@deepseek-ai/dsh-session-format-v4-to-v5": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
