{
  "name": "@deepseek-ai/dsh-session-format-v6-to-v7",
  "description": "Producer-source and tool-role migration from Session V6 to V7 with native V7 framing",
  "version": "0.1.5-alpha.1.coharness.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-format-v6-to-v7"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "sessionFormatMigration": {
      "from": 6,
      "to": 7,
      "export": ".",
      "migration": "sessionFormatV6ToV7",
      "sourceCodec": "releasedV6SessionFormatCodec",
      "targetCodec": "releasedV7SessionFormatCodec",
      "targetHeaderValidator": "assertReleasedV7Header",
      "targetRestorer": "restoreReleasedV7Artifact"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-session-format": "workspace:*",
    "@deepseek-ai/dsh-session-format-v2-to-v3": "workspace:*",
    "@deepseek-ai/dsh-session-format-v5-to-v6": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
