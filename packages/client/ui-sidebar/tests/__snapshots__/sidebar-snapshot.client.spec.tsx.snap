// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sidebar shell snapshots > renders the collapsed rail after the crossfade settles, in place 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root collapsed railIn quietBars"
    style="--dsh-sidebar-region-top: 0px; --dsh-sidebar-region-height: 0px;"
  >
    <div
      class="logoRow"
    >
      <button
        aria-label="Open sidebar"
        class="iconButton toggle"
        type="button"
      >
        <span
          aria-hidden="true"
          class="railMark"
        >
          <div
            data-slot="sidebar.brand.mark"
            style="display: contents;"
          >
            <svg
              aria-hidden="true"
              data-brand="coharness-mascot"
              data-content="0dfbb30f"
              fill="none"
              height="24"
              viewBox="0 0 64 64"
              width="24"
            />
          </div>
        </span>
        <svg
          class="lucide lucide-panel-left lucide-sidebar panelIcon"
          data-content="1bd2ace7"
          fill="none"
          height="18"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="18"
          xmlns="http://www.w3.org/2000/svg"
        />
      </button>
    </div>
    <button
      aria-label="New session"
      class="newSession"
      type="button"
    >
      <svg
        class="lucide lucide-square-pen lucide-pen-box lucide-edit lucide-pen-square"
        data-content="72b609e2"
        fill="none"
        height="18"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="18"
        xmlns="http://www.w3.org/2000/svg"
      />
    </button>
    <div
      class="regionArea"
    >
      <div
        data-slot="sidebar.workspaces"
        style="display: contents;"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          class="settingsRow"
        >
          <div
            class="settingsTrigger"
          >
            <div
              data-slot="sidebar.settings"
              style="display: contents;"
            />
          </div>
          <div
            class="settingsActions"
          >
            <div
              data-slot="sidebar.settings.action"
              style="display: contents;"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;

exports[`sidebar shell snapshots > renders the expanded column (wordmark, capsule, empty holes) 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root quietBars"
    style="width: 300px; --dsh-sidebar-region-top: 0px; --dsh-sidebar-region-height: 0px;"
  >
    <div
      class="logoRow"
    >
      <button
        aria-label="New session"
        class="brand wide"
        type="button"
      >
        <span
          aria-hidden="true"
          class="brandIdentity"
        >
          <span
            class="brandMark"
          >
            <div
              data-slot="sidebar.brand.mark"
              style="display: contents;"
            >
              <svg
                aria-hidden="true"
                data-brand="coharness-mascot"
                data-content="0dfbb30f"
                fill="none"
                height="24"
                viewBox="0 0 64 64"
                width="24"
              />
            </div>
          </span>
          <span
            class="brandName"
          >
            <div
              data-slot="sidebar.brand.name"
              style="display: contents;"
            >
              <span
                class="fallbackBrandName"
              >
                COHARNESS
              </span>
              <span
                class="buildRevision"
              >
                abc1234
              </span>
            </div>
          </span>
        </span>
      </button>
      <button
        aria-label="Collapse sidebar"
        class="iconButton toggle"
        type="button"
      >
        <svg
          class="lucide lucide-panel-left lucide-sidebar panelIcon"
          data-content="1bd2ace7"
          fill="none"
          height="16"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="16"
          xmlns="http://www.w3.org/2000/svg"
        />
      </button>
    </div>
    <button
      aria-label="New session"
      class="newSession"
      type="button"
    >
      <svg
        class="lucide lucide-square-pen lucide-pen-box lucide-edit lucide-pen-square"
        data-content="72b609e2"
        fill="none"
        height="14"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="14"
        xmlns="http://www.w3.org/2000/svg"
      />
      <span
        class="newSessionLabel wide"
      >
        New Session
      </span>
    </button>
    <div
      class="regionArea"
    >
      <div
        data-slot="sidebar.workspaces"
        style="display: contents;"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          class="settingsRow"
        >
          <div
            class="settingsTrigger"
          >
            <div
              data-slot="sidebar.settings"
              style="display: contents;"
            />
          </div>
          <div
            class="settingsActions"
          >
            <div
              data-slot="sidebar.settings.action"
              style="display: contents;"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;

