{
  "name": "@deepseek-ai/dsh-remote-desktop-stream",
  "description": "WebSocket mount for ctx.remoteDesktop — one upgrade route on ctx.webServer, the ?token= handshake, and the ws→Duplex adapter feeding serveStream",
  "version": "0.2.1-rc.1.coharness.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/remote-desktop/remote-desktop-stream"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-remote-desktop": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-remote-desktop": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@deepseek-ai/cordis": "workspace:~",
    "@types/ws": "^8.18.1"
  }
}
