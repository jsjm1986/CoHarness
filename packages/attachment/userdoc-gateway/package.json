{
  "name": "@deepseek-ai/dsh-userdoc-gateway",
  "description": "Authenticated Gateway-backed real-file document provider",
  "version": "0.2.1-rc.1.coharness.1",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/attachment/userdoc-gateway"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./protocol": { "types": "./lib/types/protocol.d.ts", "default": "./lib/protocol.js" },
    "./server": { "types": "./lib/types/server.d.ts", "default": "./lib/server.js" },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": ["locale/*.json", "lib/index.js", "lib/protocol.js", "lib/server.js", "lib/frame-*.js", "lib/protocol-*.js", "lib/types/**/*.d.ts"],
  "license": "Apache-2.0",
  "dependencies": { "@deepseek-ai/schemastery": "workspace:~", "@deepseek-ai/dsh-util-values": "workspace:*", "zod": "^4.4.3" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-execution-authority": "workspace:*",
    "@deepseek-ai/dsh-gateway-runtime": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-userdoc": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-execution-authority": "workspace:*",
    "@deepseek-ai/dsh-gateway-runtime": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-userdoc": "workspace:*",
    "@deepseek-ai/dsh-userdoc-local": "workspace:*"
  }
}
