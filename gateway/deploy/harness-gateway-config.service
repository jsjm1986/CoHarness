# Independent configuration worker. Share the same private bootstrap environment
# file with harness-gateway.service; restarting Gateway must not kill this worker.
[Unit]
Description=CoHarness current-node configuration applier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/harness/gateway
EnvironmentFile=/srv/harness/gateway-data/node-launch.env
ExecStart=/usr/local/bin/node lib/node-config-cli.js watch
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
