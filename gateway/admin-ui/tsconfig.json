{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "@deepseek-ai/cordis": ["../../vendor/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/cosmokit": ["../../vendor/cosmokit/lib/types/index.d.ts"],
      "@deepseek-ai/schemastery": ["../../vendor/schemastery/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-runtime/client": ["../../packages/client/runtime/src/client/index.ts"],
      "@deepseek-ai/dsh-client-ui-primitives": ["./src/model-settings-primitives.ts"]
    }
  },
  "include": ["src", "../../scripts/types/client-build-environment/index.d.ts"]
}
