  "upstreamOnly": [
    {
      "package": "api/workspace-files",
      "reason": "workspace file reads are served by host/apiproxy workspaceFiles RPC under Session ACL and containment; the upstream standalone package is not carried",
      "replacedBy": "host/apiproxy"
    },
    {
      "package": "client/file-upload",
      "reason": "attachment/userdoc-local plus host/userdoc-http provide resumable chunked upload with SHA-256 resume; the upstream transient file-upload receipt surface is deferred"
    },
    {
      "package": "client/product-analytics",
      "reason": "product analytics lane excluded"
    },
    {
      "package": "client/resources",
      "reason": "cloud runtime resources live in client/runtime WorkspaceResourceRegistry bound to bootstrap/project runtimes; the upstream single-session registry is not carried",
      "replacedBy": "client/runtime"
    },
    {
      "package": "client/store",
      "reason": "single-session store is not carried; imports are rewritten onto client/runtime store exports per adopted package (no shim package)",
      "replacedBy": "client/runtime"
    },
    {
      "package": "client/ui-approval",
      "reason": "approval surfaces live inside the CoHarness Workbench conversation UI"
    },
    {
      "package": "client/ui-chat",
      "reason": "client/ui-conversation owns the chat surface for the cloud product",
      "replacedBy": "client/ui-conversation"
    },
    {
      "package": "client/ui-session",
      "reason": "client/ui-conversation and ui-workbench own the session surface",
      "replacedBy": "client/ui-conversation"
    },
    {
      "package": "client/ui-settings-account",
      "reason": "account settings UI excluded; CoHarness account surface is separate",
      "replacedBy": "client/ui-settings"
    },
    {
      "package": "client/ui-settings-agent-loop",
      "reason": "upstream settings section content lands inside the fork settings surface",
      "replacedBy": "client/ui-settings"
    },
    {
      "package": "client/ui-settings-session-log",
      "reason": "upstream settings section content lands inside the fork settings surface",
      "replacedBy": "client/ui-settings"
    },
    {
      "package": "client/ui-settings-shell",
      "reason": "upstream settings section content lands inside the fork settings surface",
      "replacedBy": "client/ui-settings"
    },
    {
      "package": "client/ui-settings-subagent",
      "reason": "upstream settings section content lands inside the fork settings surface",
      "replacedBy": "client/ui-settings"
    },
    {
      "package": "client/ui-settings-web-search",
      "reason": "upstream settings section content lands inside the fork settings surface",
      "replacedBy": "client/ui-settings"
    },
    {
      "package": "client/ui-sidebar-documentpreview",
      "reason": "document preview is part of the rejected upstream sidebar tree; the Workbench document surface owns previews, including the Markdown and HTML bodies registered upstream",
      "replacedBy": "client/ui-workbench"
    },
    {
      "package": "client/ui-sidebar-files",
      "reason": "the desktop file sidebar is part of the rejected upstream ui-package tree; workspace browsing is owned by the cloud Workbench"
    },
    {
      "package": "client/ui-settings-plugin-inventory",
      "reason": "the inventory tab duplicated install, removal, and enablement already owned by the sidebar Plugins panel; it is not carried",
      "replacedBy": "client/ui-plugin-manager"
    },
    {
      "package": "experimental/inspector",
