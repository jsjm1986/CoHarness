    "vitest": "4.1.8",
    "@deepseek-ai/dsh-execution-authority": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-stagehand-native": "workspace:*",
    "@deepseek-ai/dsh-web": "workspace:*",
