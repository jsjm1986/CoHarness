{
  "name": "@deepseek-ai/dsh-model-governance",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "Per-instance model authorization and reliable usage reporting plugin.",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-archive-gateway": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-gateway-runtime": "*",
    "@deepseek-ai/dsh-gateway-execution": "*",
    "@deepseek-ai/dsh-archive-gateway": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-model-access": "*",
    "@deepseek-ai/dsh-model-provider-config": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-execution-authority": "*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-archive-gateway": "workspace:*",
    "@types/node": "22.20.0",
